{
  "name": "youtube-saver",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/ensure-yt-dlp.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "dist:mac": "node scripts/assemble-desktop.mjs && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "dist:win": "node scripts/assemble-desktop.mjs --win && electron-builder --win nsis --x64",
    "dist": "node scripts/assemble-desktop.mjs --win && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "youtube-dl-exec": "^3.1.17"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
